    "steps": [
        {
            "text": "De naam is alleen voor jou. De klant ziet hem niet. Kies iets dat je snel terugvindt.",
            "hash": "9d07f9baa82c40b2339edc33d92ed7bbdfe118d3",
            "start": 0,
            "end": 4.016
        },
        {
            "text": "Het onderwerp ziet de klant als eerste. Houd het kort en duidelijk.",
            "hash": "47d6e63b5eed9c30a3a73af5cb174b6f914a09e7",
            "start": 5.016,
            "end": 8.209
        },
        {
            "text": "Hier schrijf je de tekst. Gewoon zoals je een brief schrijft.",
            "hash": "e8ddb15fe04870c631dca2d5a2aef47289663a08",
            "start": 9.209,
            "end": 12.004
        },
        {
            "text": "Met deze knoppen maak je tekst vet of schuin. Of je maakt een lijstje. Selecteer eerst de tekst. Klik dan op de knop.",
            "hash": "0f0ca413d97d6cff839e7502b8dbae6389aff73b",
            "start": 13.004,
            "end": 20.334
        }
    ]
}

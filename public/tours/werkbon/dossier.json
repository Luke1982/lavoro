    "steps": [
        {
            "text": "Onder afspraken zie je wanneer er iemand langskomt, en wie er gaat.",
            "hash": "af233f54c7f200164395eda87aa54a64af9d50ec",
            "start": 0,
            "end": 3.39
        },
        {
            "text": "Er zijn externe en interne opmerkingen. Een externe opmerking ziet de klant op de werkbon. Een interne opmerking blijft bij jullie.",
            "hash": "23df41486e075916687e4fa99dbc64497ade4bf9",
            "start": 4.39,
            "end": 10.955
        },
        {
            "text": "Ook foto's zijn er extern en intern. Alleen de externe foto's komen op de werkbon voor de klant.",
            "hash": "8b4b35e00d10bc8be9ba2806023c066dc77c2f0f",
            "start": 11.955,
            "end": 17.951
        },
        {
            "text": "Bij documenten zet je bestanden bij de werkbon.",
            "hash": "77ea08b0ec784afb07165590976c96768f09d440",

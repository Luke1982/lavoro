{
    "tour": "planner",
    "chapter": "telefoon",
    "version": 1,
    "voice": "elevenlabs:Zg5vPmUEsvYSlZqStoWP:eleven_multilingual_v2",
    "audio": "telefoon.mp3",
    "gap": 1,
    "steps": [
        {
            "text": "Op je telefoon zie je de week als een lijst, dag voor dag.",
            "hash": "67d533d1a4398e0a9cb75cfeeca2bb73017207ef",
            "start": 0,
            "end": 3.39
        },
        {
            "text": "Naar een andere week? Tik op de pijltjes, of veeg de lijst opzij.",
            "hash": "a13cfe9a9fd602494159a64c2158d2af12f3e536",
            "start": 4.39,
            "end": 7.827
        },
        {
            "text": "Mag je de hele planning zien, dan kies je hier een monteur, of alle monteurs. Je telefoon onthoudt wat je koos.",
            "hash": "c9a141405c87a672a5b7f82651efb694300bf4b2",
            "start": 8.827,
            "end": 14.725
        },
        {
            "text": "Kijk je naar alle monteurs, dan zet je ze met deze knop als banen naast elkaar.",
            "hash": "ca9597629b1a336c6dc7bc03fab5597df85d5c07",
            "start": 15.725,
            "end": 20.043
        },
        {
            "text": "Met de groene plusknop maak je een nieuwe afspraak.",
            "hash": "63098bbcb387fb9fe744d2ea97f0972af8ffaccc",
            "start": 21.043,
            "end": 23.923
        },
        {
            "text": "Tik op een afspraak om hem te openen.",
            "hash": "e33e4c186a35fb443c292d48bd8462f8537b6893",
            "start": 24.923,
            "end": 27.338
        },
        {
            "text": "Onderaan dat scherm staat de knop om de afspraak te verwijderen. Die vraagt altijd eerst of je het zeker weet.",
            "hash": "60578dd38c5607800e93c6ae44552a24d300e4d2",
            "start": 28.338,
            "end": 34.328
        }
    ]
}

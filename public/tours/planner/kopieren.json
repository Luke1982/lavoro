    "gap": 1,
    "steps": [
        {
            "text": "Moet een klus vaker gebeuren? Klik met de rechtermuisknop op de afspraak en kies kopiëren.",
            "hash": "d2a510d92657876735bb235bdba43f1692fa72bf",
            "start": 0,
            "end": 4.876
        },
        {
            "text": "Met naar morgen zet je hem een dag later neer, op dezelfde tijd.",
            "hash": "06bb1a053f4c07a88ed374fa2b9e4344407fbcf8",
            "start": 5.876,
            "end": 9.452
        },
        {
            "text": "Met rest van de week komt hij op elke werkdag die deze week nog over is.",
            "hash": "80eb766b3bcece0a51390ada1a02c3e4fa20cccf",
            "start": 10.452,
            "end": 14.957
        },
        {
            "text": "Met naar volgende week zet je hem precies een week later.",
            "hash": "fa8e6171198812983f58d5c0e1f67573607b747e",
            "start": 15.957,
            "end": 18.929
        },
        {
            "text": "Of kies zelf een datum, tot een jaar voor of na de afspraak. De tijd blijft gelijk, ook als de zomertijd ertussen zit.",
            "hash": "db36640eba42033d0325d863bf511b7b0da02933",
            "start": 19.929,
            "end": 27.174
        }
    ]
}

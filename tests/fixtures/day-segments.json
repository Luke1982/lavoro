{
  "_comment": [
    "Shared between the PHP and the JavaScript day-segment code. Both read this",
    "file, so the day the two stop agreeing a test goes red instead of a planner",
    "being told someone is free when the assistant says they are not.",
    "",
    "The cases describe the segment algebra only: given a working window, the",
    "stretches already booked, and the stretches blocked, what is left. Turning",
    "appointments and unavailabilities into those bands is done separately in",
    "each language and tested there — it reads from a database on one side and",
    "from a loaded payload on the other, and pretending otherwise would make the",
    "fixture about plumbing rather than about the arithmetic that can drift.",
    "",
    "All boundaries are minutes from midnight. Segments shorter than 15 minutes",
    "are dropped as noise rather than reported as bookable."
  ],
  "min_segment_minutes": 15,
  "cases": [
    {
      "name": "an empty day is one free stretch",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [],
      "blocked": [],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 1020 }
      ]
    },
    {
      "name": "one appointment splits the day in two",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [{ "start_min": 600, "end_min": 720 }],
      "blocked": [],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 600 },
        { "kind": "free", "start_min": 720, "end_min": 1020 }
      ]
    },
    {
      "name": "an appointment filling the day leaves nothing",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [{ "start_min": 480, "end_min": 1020 }],
      "blocked": [],
      "expect": []
    },
    {
      "name": "work outside the window does not create room outside it",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [{ "start_min": 0, "end_min": 480 }, { "start_min": 1020, "end_min": 1440 }],
      "blocked": [],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 1020 }
      ]
    },
    {
      "name": "overlapping appointments merge into one busy stretch",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [
        { "start_min": 540, "end_min": 660 },
        { "start_min": 600, "end_min": 720 }
      ],
      "blocked": [],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 540 },
        { "kind": "free", "start_min": 720, "end_min": 1020 }
      ]
    },
    {
      "name": "appointments touching end to end merge rather than leaving a sliver",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [
        { "start_min": 540, "end_min": 600 },
        { "start_min": 600, "end_min": 660 }
      ],
      "blocked": [],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 540 },
        { "kind": "free", "start_min": 660, "end_min": 1020 }
      ]
    },
    {
      "name": "a blocked stretch is reported as blocked, not as missing",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [],
      "blocked": [{ "start_min": 480, "end_min": 1020, "label": "Papadag" }],
      "expect": [
        { "kind": "blocked", "start_min": 480, "end_min": 1020, "label": "Papadag" }
      ]
    },
    {
      "name": "a block inside the day leaves free stretches either side of it",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [],
      "blocked": [{ "start_min": 720, "end_min": 780, "label": "Lunch" }],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 720 },
        { "kind": "blocked", "start_min": 720, "end_min": 780, "label": "Lunch" },
        { "kind": "free", "start_min": 780, "end_min": 1020 }
      ]
    },
    {
      "name": "a block is clipped to the working window",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [],
      "blocked": [{ "start_min": 0, "end_min": 1440, "label": "Vakantie" }],
      "expect": [
        { "kind": "blocked", "start_min": 480, "end_min": 1020, "label": "Vakantie" }
      ]
    },
    {
      "name": "a block under an appointment is not reported twice",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [{ "start_min": 600, "end_min": 720 }],
      "blocked": [{ "start_min": 600, "end_min": 720, "label": "Papadag" }],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 600 },
        { "kind": "free", "start_min": 720, "end_min": 1020 }
      ]
    },
    {
      "name": "slivers below the minimum are dropped rather than offered",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [
        { "start_min": 500, "end_min": 600 },
        { "start_min": 605, "end_min": 1020 }
      ],
      "blocked": [],
      "expect": [
        { "kind": "free", "start_min": 480, "end_min": 500 }
      ]
    },
    {
      "name": "a gap exactly at the minimum is kept",
      "work_start_hour": 8,
      "work_end_hour": 17,
      "busy": [
        { "start_min": 480, "end_min": 600 },
        { "start_min": 615, "end_min": 1020 }
      ],
      "blocked": [],
      "expect": [
        { "kind": "free", "start_min": 600, "end_min": 615 }
      ]
    },
    {
      "name": "everything at once stays in order",
      "work_start_hour": 7,
      "work_end_hour": 18,
      "busy": [
        { "start_min": 480, "end_min": 570 },
        { "start_min": 555, "end_min": 630 }
      ],
      "blocked": [{ "start_min": 720, "end_min": 780, "label": "Lunch" }],
      "expect": [
        { "kind": "free", "start_min": 420, "end_min": 480 },
        { "kind": "free", "start_min": 630, "end_min": 720 },
        { "kind": "blocked", "start_min": 720, "end_min": 780, "label": "Lunch" },
        { "kind": "free", "start_min": 780, "end_min": 1080 }
      ]
    }
  ]
}

#!/usr/bin/env bash
#
# One command for everything you do to a Lavoro installation.
#
#   lavoro status                  is this installation healthy, and is it current
#   lavoro update                  fetch and deploy the new version
#   lavoro help                    every command
#
# This is a front door, not a rewrite: deploying, backing up, importing and the
# setup scripts still live in scripts/, and still run on their own. What this
# adds is one place to look, one spelling to remember, and the checks nobody
# runs because they are four separate commands.
#
# It works out where the installation is from its own path, so it can be
# symlinked onto PATH and run from anywhere.
set -uo pipefail

case "$(readlink -f "${BASH_SOURCE[0]}")" in
    */*) SELF="$(readlink -f "${BASH_SOURCE[0]}")" ;;
    *)   SELF="$PWD/${BASH_SOURCE[0]}" ;;
esac
ROOT="$(cd "${SELF%/bin/*}" && pwd)"

# shellcheck source=../scripts/tenancy/lib.sh
source "$ROOT/scripts/tenancy/lib.sh"

BACKUP_DIR="${LAVORO_BACKUP_DIR:-$ROOT/storage/backups}"

# ---------------------------------------------------------------------------
# Running things as the right account
# ---------------------------------------------------------------------------

# The account the installation belongs to, read from the files rather than
# assumed. Artisan as root leaves root-owned caches and logs behind, and the
# next web request cannot write them.
APP_ACCOUNT="$(stat -c %U "$ROOT/artisan" 2>/dev/null || echo "$USER")"

# Everything that has to run as that account, and not as whoever is reading.
#
# Root is the normal way to run this tool, and root is exactly who may not run
# these two. Artisan as root leaves root-owned caches and logs behind, and the
# next web request cannot write them. Git refuses outright: it will not work in
# a checkout that belongs to somebody else ("detected dubious ownership"), so
# 'sudo lavoro status' used to report an installation that was not a git
# checkout at all -- while the only thing wrong was who was asking.
#
# With 'sudo -n', which fails instead of asking: nothing here may stop for a
# password, because a command waiting for an answer nobody is there to give
# looks exactly like one that has hung.
as_owner() {
    if [ "$(id -un)" = "$APP_ACCOUNT" ]; then
        "$@"
    else
        sudo -n -u "$APP_ACCOUNT" "$@"
    fi
}

artisan() { (cd "$ROOT" && as_owner php artisan "$@"); }

git_here() { as_owner git -C "$ROOT" "$@"; }

# The same git command, written out so the reader can paste it. It has to run as
# the account the files belong to, so when that is not the reader, the line
# carries the sudo that makes it work -- otherwise they get the ownership
# refusal and nothing happens.
git_command() {
    if [ "$(id -un)" = "$APP_ACCOUNT" ]; then
        printf 'git -C %s %s' "$ROOT" "$*"
    else
        printf 'sudo -u %s git -C %s %s' "$APP_ACCOUNT" "$ROOT" "$*"
    fi
}

# Everything that only reads. Used by status, where one unreachable thing must
# not stop the rest of the report.
quietly() { "$@" >/dev/null 2>&1; }

heading() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# What a stopped worker actually costs, per unit, so the reason is worth reading.
what_stops() {
    case "$1" in
        lavoro-worker)       printf 'no mail, no pdfs, no Google sync' ;;
        lavoro-provisioning) printf 'no customer can be created or deleted' ;;
        *)                   printf 'queued work is not being done' ;;
    esac
}

# A fixed-width label so the answers line up, whatever the question was.
line() { printf '  %-22s %s\n' "$1" "$2"; }

ok()    { line "$1" "$(printf '\033[32m%s\033[0m' "$2")"; }
warn_line() { line "$1" "$(printf '\033[33m%s\033[0m' "$2")"; }
bad_line()  { line "$1" "$(printf '\033[31m%s\033[0m' "$2")"; }

# What the reader should do about what was just printed. Collected while the
# checks run and listed at the end, because a report that names a problem and
# not its remedy sends people looking through documentation for a command this
# tool already knows.
TODO_COMMANDS=()
TODO_REASONS=()

todo() {
    local existing

    # One command, once: two stopped workers are one restart, not two. Guarded
    # because an empty array under 'set -u' is an error in older bash.
    if [ "${#TODO_COMMANDS[@]}" -gt 0 ]; then
        for existing in "${TODO_COMMANDS[@]}"; do
            [ "$existing" = "$1" ] && return 0
        done
    fi

    TODO_COMMANDS+=("$1")
    TODO_REASONS+=("$2")
}

confirm() {
    local answer
    printf '%s [y/N] ' "$1"
    read -r answer
    [ "$answer" = "y" ] || [ "$answer" = "Y" ]
}

# ---------------------------------------------------------------------------
# What is installed here
# ---------------------------------------------------------------------------

current_branch() { git_here rev-parse --abbrev-ref HEAD 2>/dev/null; }

current_commit() { git_here log -1 --format='%h %cd %s' --date=short 2>/dev/null; }

# How far behind origin this checkout is. Fetches first, because a checkout that
# never fetches is always "up to date". Never fails the caller: a server without
# a network should still report everything else.
#
# Nothing here may ask a question. A deploy key with a passphrase, or a host that
# is not in known_hosts, otherwise leaves 'lavoro status' waiting on a prompt
# forever -- which is what a hung status command looks like from the outside. So
# ssh is told to fail instead of asking, git is told not to prompt for a
# password, and the whole thing is given twenty seconds.
behind_count() {
    local branch
    branch="$(current_branch)"

    quietly as_owner env GIT_TERMINAL_PROMPT=0 \
        GIT_SSH_COMMAND='ssh -oBatchMode=yes -oStrictHostKeyChecking=accept-new -oConnectTimeout=10' \
        timeout 20 git -C "$ROOT" fetch --quiet origin "$branch" || return 1

    git_here rev-list --count "HEAD..origin/${branch}" 2>/dev/null
}

uncommitted() { git_here status --porcelain --untracked-files=no 2>/dev/null; }

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

cmd_status() {
    local branch commit behind dirty

    heading "Installation"
    line "folder" "$ROOT"
    line "account" "$APP_ACCOUNT"

    branch="$(current_branch)"
    commit="$(current_commit)"

    if [ -z "$branch" ] && [ -d "$ROOT/.git" ]; then
        bad_line "branch" "git will not read this checkout as $(id -un)"
        todo "sudo -u ${APP_ACCOUNT} lavoro status" \
            "the files belong to ${APP_ACCOUNT}, and git refuses a checkout owned by somebody else"
    else
        line "branch" "${branch:-not a git checkout}"
    fi

    line "version" "${commit:-unknown}"

    dirty="$(uncommitted)"
    if [ -n "$dirty" ]; then
        warn_line "local changes" "$(printf '%s' "$dirty" | wc -l) file(s) changed here -- a deploy will refuse"
        todo "$(git_command status)" "see what was changed by hand; a deploy stops until it is put back"
    fi

    heading "Updates"
    behind="$(behind_count)"
    if [ -z "$behind" ]; then
        warn_line "origin" "could not be reached"
        todo "$(git_command fetch origin)" "run it by hand to see why: no network, or a key that wants a passphrase"
    elif [ "$behind" -eq 0 ]; then
        ok "origin" "up to date"
    else
        warn_line "origin" "${behind} commit(s) behind"
        todo "lavoro update --check" "see what is in those ${behind} commit(s), then: lavoro update"
        git_here log --oneline --no-decorate "HEAD..origin/${branch}" 2>/dev/null \
            | head -5 | sed 's/^/      /'
    fi

    heading "Services"
    local unit
    for unit in lavoro-worker lavoro-provisioning; do
        if ! quietly command -v systemctl; then
            line "$unit" "no systemd here"
        elif [ "$(systemctl is-active "$unit" 2>/dev/null)" = "active" ]; then
            ok "$unit" "running"
        else
            bad_line "$unit" "not running"
            todo "lavoro workers restart" "a background process is down: $(what_stops "$unit")"
        fi
    done

    if crontab -l -u "$APP_ACCOUNT" 2>/dev/null | grep -q 'schedule:run'; then
        ok "cron" "scheduler installed"
    else
        bad_line "cron" "no schedule:run"
        todo "sudo lavoro setup workers" "without the cron line: no invoices, no Google sync, no demo rebuild"
    fi

    heading "Room"
    local free_mb used
    free_mb="$(df -Pm "$ROOT" | awk 'NR == 2 { print $4 }')"
    used="$(df -Ph "$ROOT" | awk 'NR == 2 { print $5 }')"

    if [ "${free_mb:-0}" -lt 2048 ]; then
        bad_line "disk" "${free_mb} MB free (${used} used)"
        todo "lavoro backup list" "almost full; old dumps are usually the cause (delete with --keep-days)"
    elif [ "${free_mb:-0}" -lt 10240 ]; then
        warn_line "disk" "${free_mb} MB free (${used} used)"
    else
        ok "disk" "$(( free_mb / 1024 )) GB free (${used} used)"
    fi

    heading "Backups"
    backup_status

    heading "Security"
    fail2ban_status

    heading "Customers and checks"
    tenant_count
    doctor_summary

    next_steps
}

# Everything the checks above flagged, as commands you can paste, in the order
# they were found.
next_steps() {
    local i

    if [ "${#TODO_COMMANDS[@]}" -eq 0 ]; then
        heading "Nothing to do"
        line "" "This installation is healthy and up to date."
        printf '\n  All commands: \033[1mlavoro help\033[0m\n\n'
        return
    fi

    heading "What to do (${#TODO_COMMANDS[@]})"

    for i in "${!TODO_COMMANDS[@]}"; do
        printf '  %d. \033[1m%s\033[0m\n     %s\n' \
            "$(( i + 1 ))" "${TODO_COMMANDS[$i]}" "${TODO_REASONS[$i]}"
    done

    printf '\n  All commands: \033[1mlavoro help\033[0m\n\n'
}

# The newest dump, and how old it is. A backup nobody looks at is the normal way
# to find out, months later, that it stopped working.
backup_status() {
    local newest age_days count

    if [ ! -d "$BACKUP_DIR" ]; then
        warn_line "backups" "no folder ${BACKUP_DIR}"
        return
    fi

    newest="$(find "$BACKUP_DIR" -maxdepth 1 -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | head -1 | cut -d' ' -f2-)"

    if [ -z "$newest" ]; then
        bad_line "backups" "none in ${BACKUP_DIR}"
        todo "lavoro backup --keep-days=14" "there is no backup of any database at all"
        return
    fi

    count="$(find "$BACKUP_DIR" -maxdepth 1 -name '*.sql.gz' | wc -l)"
    age_days=$(( ( $(date +%s) - $(stat -c %Y "$newest") ) / 86400 ))

    if [ "$age_days" -ge 7 ]; then
        bad_line "newest dump" "${age_days} days old"
        todo "lavoro backup --keep-days=14" "the newest backup is ${age_days} days old"
    elif [ "$age_days" -ge 2 ]; then
        warn_line "newest dump" "${age_days} days old"
    else
        ok "newest dump" "$(date -d "@$(stat -c %Y "$newest")" '+%Y-%m-%d %H:%M')"
    fi

    line "dumps kept" "${count} file(s), $(du -sh "$BACKUP_DIR" 2>/dev/null | cut -f1)"

    if [ "$BACKUP_DIR" = "$ROOT/storage/backups" ]; then
        warn_line "where" "inside the installation -- same disk as the databases"
        todo "LAVORO_BACKUP_DIR=/backups/lavoro lavoro backup" "a copy on this disk is gone when this server is; then rsync it off the machine"
    fi
}

# Whether refused logins are actually acted on. The application writes them
# down on its own, so the file filling up proves nothing: without the jail
# reading it, nobody is ever blocked.
#
# Carefully split into three questions, because they have different answers and
# only the first two can be asked without root: is fail2ban installed, is
# Lavoro's jail configured, and who is banned right now. Reaching fail2ban's
# socket needs root, and "I may not ask" was reported here as "it is not there"
# -- on a server where it had just been set up.
FAIL2BAN_JAIL="${LAVORO_FAIL2BAN_JAIL:-/etc/fail2ban/jail.d/lavoro.conf}"

fail2ban_status() {
    local log="$ROOT/storage/logs/auth.log" banned

    if [ -f "$log" ]; then
        ok "refused logins" "$(wc -l < "$log") line(s) in storage/logs/auth.log"
    else
        line "refused logins" "no file yet (nobody has been refused since this was installed)"
    fi

    if ! quietly command -v fail2ban-client; then
        bad_line "fail2ban" "not installed"
        todo "sudo apt install fail2ban && sudo lavoro setup fail2ban" \
            "nothing blocks somebody trying passwords all night"
        return
    fi

    if [ ! -f "$FAIL2BAN_JAIL" ]; then
        bad_line "fail2ban" "installed, but Lavoro's jail was never set up"
        todo "sudo lavoro setup fail2ban" "refused logins are written down but nobody is ever blocked"
        return
    fi

    if quietly command -v systemctl && [ "$(systemctl is-active fail2ban 2>/dev/null)" != "active" ]; then
        bad_line "fail2ban" "jail is configured, but fail2ban itself is not running"
        todo "sudo systemctl start fail2ban" "the jail exists on disk but nothing is reading the log"
        return
    fi

    # Live numbers, if this account may ask for them. Root can; the application
    # account normally cannot, and that is not a problem to report.
    banned="$(fail2ban-client status lavoro-auth 2>/dev/null \
        | grep -oP 'Currently banned:\s*\K[0-9]+' | head -1)"

    if [ -z "$banned" ] && [ "$(id -u)" -ne 0 ]; then
        banned="$(sudo -n fail2ban-client status lavoro-auth 2>/dev/null \
            | grep -oP 'Currently banned:\s*\K[0-9]+' | head -1)"
    fi

    if [ -n "$banned" ]; then
        ok "fail2ban" "watching auth.log, ${banned} address(es) banned right now"
    else
        ok "fail2ban" "jail installed, fail2ban running (who is banned needs root)"
    fi
}

tenant_count() {
    # Rows of the table tenants:list prints, minus its header. Counting the rows
    # rather than matching a database name keeps this working whatever the
    # prefix is on this installation.
    local count rows
    rows="$(artisan tenants:list 2>/dev/null | grep -c '^| ' || true)"
    count=$(( rows > 0 ? rows - 1 : 0 ))

    if [ "${count:-0}" -eq 0 ]; then
        warn_line "customers" "none, or the list could not be read"
    else
        ok "customers" "$count"
    fi
}

# The doctor's own summary line, so status says whether anything is wrong
# without printing fifty lines of its own.
doctor_summary() {
    local output tail_line report

    # The doctor walks every customer and takes a few seconds, so say so while
    # it runs. Its own output is read here rather than shown: the summary and
    # the failing lines are what belong in a status report.
    report="$(mktemp)"
    SPINNER_OUTPUT="$report" SPINNER_QUIET=1 spinner_run "asking the doctor about every customer" \
        artisan tenancy:doctor
    output="$(cat "$report")"
    rm -f "$report"

    # Two possible last words: "All fine (74 checks)." when nothing is wrong, and
    # "6 problem(s), 56 fine." when something is. Looking for only one of them
    # made a healthy installation report that the check had not finished.
    tail_line="$(printf '%s' "$output" \
        | grep -E 'All fine \([0-9]+ checks\)|[0-9]+ problem\(s\), [0-9]+ fine' | tail -1)"

    # No summary line means it stopped somewhere, which is itself the finding.
    # Printing its last words beats "did not finish", which sends you to run the
    # same command again by hand to find out what this already knows.
    if [ -z "$tail_line" ]; then
        bad_line "doctor" "stopped before it was done"
        printf '%s' "$output" | tail -5 | sed 's/^/      /'
        todo "lavoro doctor" "the check itself fails; the lines above are where it stopped"
        return
    fi

    if printf '%s' "$tail_line" | grep -qE '^All fine|^0 problem'; then
        ok "doctor" "$tail_line"
        return
    fi

    bad_line "doctor" "$tail_line"
    printf '%s' "$output" | grep -E '^\s*FAIL' | head -8 | sed 's/^ */      /'
    todo "lavoro doctor" "$tail_line Each line says what to do about it"
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------

cmd_update() {
    local branch behind dirty check_only=0

    [ "${1:-}" = "--check" ] && check_only=1

    branch="$(current_branch)"
    [ -n "$branch" ] || die "This is not a git checkout, so there is nothing to update."

    info "Fetching origin/${branch}..."
    behind="$(behind_count)"

    if [ -z "$behind" ]; then
        die "Could not reach origin within twenty seconds.
Run '$(git_command fetch origin)' by hand to see why. A deploy key with a
passphrase is the usual reason: nothing here may stop to ask for one, because a
status command that waits for an answer looks exactly like one that has hung."
    fi

    if [ "$behind" -eq 0 ]; then
        green "Already on the newest version ($(current_commit))."
        return 0
    fi

    info ""
    info "${behind} commit(s) waiting:"
    git_here log --oneline --no-decorate "HEAD..origin/${branch}" | sed 's/^/  /'
    info ""

    if git_here diff --quiet "HEAD..origin/${branch}" -- database/migrations; then
        info "  No database changes."
    else
        warn "  Includes database changes:"
        git_here diff --name-only "HEAD..origin/${branch}" -- database/migrations | sed 's/^/    /'
    fi

    if [ "$check_only" -eq 1 ]; then
        info ""
        info "Run 'lavoro update' to install this."
        return 0
    fi

    dirty="$(uncommitted)"
    if [ -n "$dirty" ]; then
        red "Files have been changed on this server, so the deploy would stop halfway:"
        printf '%s\n' "$dirty" | sed 's/^/  /'
        info ""
        info "  See what changed:   $(git_command 'diff -- <file>')"
        info "  Throw it away:      $(git_command 'checkout -- <file>')"
        info ""
        info "  A file under storage/ is almost always a placeholder that only exists to"
        info "  keep an empty folder in git. Those are safe to throw away. A file under"
        info "  app/, config/ or resources/ is somebody's change: look at it first."
        info ""

        if printf '%s' "$dirty" | grep -qvE '^\s*M\s+storage/'; then
            die "Nothing was deployed."
        fi

        warn "  All of these are under storage/."
        confirm "  Throw those changes away and carry on?" || { info "Nothing done."; return 1; }

        printf '%s' "$dirty" | awk '{ print $2 }' | while read -r path; do
            git_here checkout -- "$path"
        done

        green "  put back"
    fi

    info ""
    warn "Deploying takes the installation offline for everyone while it runs."
    confirm "Deploy now?" || { info "Nothing done."; return 1; }

    # As the owning account, whoever started this: the deploy pulls, writes the
    # caches and runs the build, and all of that has to end up belonging to the
    # account the web server runs php as.
    as_owner bash "$ROOT/scripts/deploy.sh"
}

# ---------------------------------------------------------------------------
# tenants
# ---------------------------------------------------------------------------

cmd_tenants() {
    case "${1:-list}" in
        list|"")   artisan tenants:list ;;
        overview)  artisan tenant:overview ;;
        create)    shift; artisan tenant:create "$@" ;;
        delete)    shift; artisan tenant:delete "$@" ;;
        admin)     shift; artisan tenant:admin "$@" ;;
        import)
            shift
            [ "$(id -u)" -eq 0 ] || die "Importing an installation needs root: sudo lavoro tenants import ..."
            bash "$ROOT/scripts/tenancy/import-install.sh" "$@" ;;
        *) die "Unknown: lavoro tenants $1. Try: list, overview, create, delete, admin, import" ;;
    esac
}

# ---------------------------------------------------------------------------
# backup and restore
# ---------------------------------------------------------------------------

cmd_backup() {
    case "${1:-run}" in
        run|"")
            shift 2>/dev/null || true
            bash "$ROOT/scripts/tenancy/backup.sh" --to="$BACKUP_DIR" "$@" ;;
        list)
            [ -d "$BACKUP_DIR" ] || die "No backup folder: ${BACKUP_DIR}"
            info "In ${BACKUP_DIR}, newest first:"
            find "$BACKUP_DIR" -maxdepth 1 -name '*.sql.gz' -printf '%T@ %TY-%Tm-%Td %TH:%TM  %10s  %f\n' \
                | sort -rn | cut -d' ' -f2- | head -40 ;;
        *) die "Unknown: lavoro backup $1. Try: run, list" ;;
    esac
}

# Putting one customer's database back. The dangerous one, so it asks for the
# customer's name in full and says what it is about to replace.
cmd_restore() {
    local database="${1:-}" dump="${2:-}" defaults="${LAVORO_MYSQL_DEFAULTS:-/root/backup.cnf}"

    [ -n "$database" ] && [ -n "$dump" ] || die "Usage: sudo lavoro restore <database> <dump.sql.gz>
Example: sudo lavoro restore lavoro_tenant_acme ${BACKUP_DIR}/lavoro_tenant_acme-2026-09-20_04-00-01.sql.gz
See which database belongs to which customer with: lavoro tenants"

    [ "$(id -u)" -eq 0 ] || die "Restoring needs root: sudo lavoro restore ..."
    [ -f "$dump" ] || die "No such dump: ${dump}"
    [ -f "$defaults" ] || die "No MySQL credentials at ${defaults}.
Create it (user and password of an account that may write to ${database}), chmod 600,
or point LAVORO_MYSQL_DEFAULTS at another file. See docs/operations/backup-restore.md."

    require_commands mysql gunzip

    info "About to replace the contents of ${database}"
    info "  from: ${dump}"
    info "  made: $(date -d "@$(stat -c %Y "$dump")" '+%Y-%m-%d %H:%M')"
    info ""
    warn "Everything now in ${database} is gone, and the installation goes offline while this runs."
    confirm "Continue?" || { info "Nothing done."; return 1; }

    artisan app:maintenance --message="Bezig met herstel."

    if gunzip -c "$dump" | mysql --defaults-extra-file="$defaults" "$database"; then
        green "  loaded"
    else
        red "  the restore failed -- the installation is still offline on purpose"
        red "  put it back online yourself with: lavoro maintenance off"
        return 1
    fi

    artisan tenants:migrate
    artisan tenancy:doctor
    artisan app:maintenance

    green "Done. Restore this customer's files from the same moment as well:"
    info "  rsync -a ${BACKUP_DIR}/files/tenant-<customer id>/ ${ROOT}/storage/tenant-<customer id>/"
}

# ---------------------------------------------------------------------------
# logs, workers, maintenance, setup
# ---------------------------------------------------------------------------

cmd_logs() {
    local what="${1:-app}" follow="${2:-}"
    local args=()

    [ "$follow" = "-f" ] || [ "$follow" = "--follow" ] && args=(-f)

    case "$what" in
        app)          tail -n 100 "${args[@]}" "$ROOT/storage/logs/laravel.log" ;;
        auth)         tail -n 100 "${args[@]}" "$ROOT/storage/logs/auth.log" ;;
        worker)       journalctl -u lavoro-worker -n 100 "${args[@]/-f/--follow}" ;;
        provisioning) journalctl -u lavoro-provisioning -n 100 "${args[@]/-f/--follow}" ;;
        *) die "Unknown log: $what. Try: app, auth, worker, provisioning" ;;
    esac
}

cmd_workers() {
    case "${1:-status}" in
        status|"")
            if quietly command -v systemctl; then
                systemctl status lavoro-worker lavoro-provisioning --no-pager | sed -n '1,12p'
            else
                warn "No systemd here."
            fi
            artisan queue:failed ;;
        restart) artisan tenancy:restart-workers ;;
        failed)  artisan queue:failed ;;
        retry)   artisan queue:retry all ;;
        flush)   artisan queue:flush ;;
        *) die "Unknown: lavoro workers $1. Try: status, restart, failed, retry, flush" ;;
    esac
}

cmd_maintenance() {
    case "${1:-}" in
        on)  shift; artisan app:maintenance --message="${1:-Onderhoud, we zijn zo terug.}" ;;
        off) artisan app:maintenance ;;
        *)   artisan app:maintenance ;;
    esac
}

# Who the web server runs as, out of what the application wrote down on a real
# request. Guessing it from `ps` finds any php-fpm on the machine, including one
# belonging to another site.
web_account() {
    local facts="$ROOT/storage/framework/web-server.json" account

    account="$(grep -oP '"account"\s*:\s*"\K[^"]+' "$facts" 2>/dev/null | head -1)"

    printf '%s' "${account:-}"
}

# Everything the two accounts that write in storage/ need, in one go.
#
# Two separate things, and the second is the one people miss. The access lists
# say who may write; the mode sets the list's mask, and a mask of r-x turns
# "may write" into read-only without removing the entry. Copying a customer's
# files in from their old installation brings that installation's modes along,
# which is how a working setup quietly becomes an unwritable one.
cmd_fix_permissions() {
    local account provisioner="lavoro_provisioner"

    [ "$(id -u)" -eq 0 ] || die "Repairing rights needs root: sudo lavoro setup permissions"

    require_commands setfacl getfacl

    account="$(web_account)"

    if [ -z "$account" ]; then
        die "This installation has not recorded which account the web server runs as.
Open any page once, then run this again. Without that, setting rights for the
wrong account looks like it worked and changes nothing."
    fi

    info ""
    info "  web server runs as  ${account}"
    info "  provisioner         ${provisioner}"
    info ""

    spinner_run "access lists for ${account}" bash -c "
        setfacl -R -m u:${account}:rwX '${ROOT}/storage' '${ROOT}/bootstrap/cache' &&
        setfacl -R -d -m u:${account}:rwX '${ROOT}/storage' '${ROOT}/bootstrap/cache'" \
        || die "Could not set the access lists."

    if id "$provisioner" >/dev/null 2>&1; then
        spinner_run "access lists for ${provisioner}" bash -c "
            setfacl -R -m u:${provisioner}:rwX '${ROOT}/storage' &&
            setfacl -R -d -m u:${provisioner}:rwX '${ROOT}/storage'" \
            || die "Could not set the access lists for ${provisioner}."
    else
        step_skip "no ${provisioner} account on this machine"
    fi

    spinner_run "modes, so the lists actually grant" \
        chmod -R u+rwX,g+rwX "$ROOT/storage" "$ROOT/bootstrap/cache" \
        || die "Could not set the modes."

    printf '\n'
    green "  Done. Check with: lavoro doctor"
    info ""
}

cmd_setup() {
    local what="${1:-}"
    shift 2>/dev/null || true

    case "$what" in
        permissions) cmd_fix_permissions "$@" ;;
        mysql)    sudo "$ROOT/scripts/tenancy/setup-mysql.sh" "$@" ;;
        workers)  sudo "$ROOT/scripts/tenancy/setup-workers.sh" "$@" ;;
        sudoers)  sudo "$ROOT/scripts/tenancy/setup-sudoers.sh" "$@" ;;
        fail2ban) sudo "$ROOT/scripts/tenancy/setup-fail2ban.sh" "$@" ;;
        env)      bash "$ROOT/scripts/tenancy/setup-env.sh" "$@" ;;
        verify)   sudo "$ROOT/scripts/tenancy/verify-mysql.sh" "$@" ;;
        cli)
            [ "$(id -u)" -eq 0 ] || die "Putting lavoro on PATH needs root: sudo lavoro setup cli"
            ln -sf "$ROOT/bin/lavoro" /usr/local/bin/lavoro
            green "ln -s ${ROOT}/bin/lavoro /usr/local/bin/lavoro" ;;
        *) die "Unknown: lavoro setup $what
Try: mysql, workers, sudoers, fail2ban, permissions, env, verify, cli" ;;
    esac
}

usage() {
    cat <<USAGE
lavoro -- one command for a Lavoro installation

  lavoro status                     is it healthy, is it current, when was the last backup
  lavoro doctor                     the full check, every customer
  lavoro update [--check]           see what is waiting, or fetch and deploy it

  lavoro tenants                    list the customers
  lavoro tenants overview           seats, storage, price, what is due
  lavoro tenants create "Name BV" admin@example.nl
  lavoro tenants delete <id>
  lavoro tenants admin <id> them@example.nl
  sudo lavoro tenants import --from /path/to/old --name "Name BV" --slug name [--refresh]

  lavoro backup [--keep-days=14]    dump every database
  lavoro backup list                what is in the backup folder
  sudo lavoro restore <database> <dump.sql.gz>

  lavoro logs [app|auth|worker|provisioning] [-f]
  lavoro workers [status|restart|failed|retry|flush]
  lavoro maintenance [on|off]

  lavoro setup <mysql|workers|sudoers|fail2ban|env|verify|cli>
  sudo lavoro setup permissions     give the web server and the provisioner their
                                    rights on storage/ again, masks included

Where things are:
  installation  ${ROOT}
  backups       ${BACKUP_DIR}   (set LAVORO_BACKUP_DIR to change)
USAGE
}

case "${1:-status}" in
    status)      shift 2>/dev/null || true; cmd_status "$@" ;;
    doctor)      shift 2>/dev/null || true; artisan tenancy:doctor "$@" ;;
    update)      shift 2>/dev/null || true; cmd_update "$@" ;;
    tenants)     shift 2>/dev/null || true; cmd_tenants "$@" ;;
    backup)      shift 2>/dev/null || true; cmd_backup "$@" ;;
    restore)     shift 2>/dev/null || true; cmd_restore "$@" ;;
    logs)        shift 2>/dev/null || true; cmd_logs "$@" ;;
    workers)     shift 2>/dev/null || true; cmd_workers "$@" ;;
    maintenance) shift 2>/dev/null || true; cmd_maintenance "$@" ;;
    setup)       shift 2>/dev/null || true; cmd_setup "$@" ;;
    artisan)     shift 2>/dev/null || true; artisan "$@" ;;
    help|-h|--help) usage ;;
    *) printf 'Unknown command: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
